# ChainSphere environment template — copy to .env
# Never commit real secrets. Only VITE_ vars are exposed to the browser.

# --- Frontend ---
VITE_APP_URL=http://localhost:5173
VITE_CHAIN_ID=31337
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
VITE_TESTNET_RPC_URL=
VITE_IDENTITY_REGISTRY_ADDRESS=
VITE_CONVERSATION_REGISTRY_ADDRESS=
VITE_MESSAGE_ANCHOR_ADDRESS=
VITE_IPFS_API_URL=http://127.0.0.1:5001
VITE_IPFS_GATEWAY_URL=https://ipfs.io
VITE_SIGNALING_URL=ws://localhost:8081
VITE_STUN_SERVERS=stun:stun.l.google.com:19302
# Optional TURN (leave empty for dev):
VITE_TURN_URL=
VITE_TURN_USERNAME=
# Never prefix secrets with VITE_. Server-only below:

SIGNALING_PORT=8081
IPFS_PINNING_PROVIDER=
IPFS_PINNING_API_KEY=
IPFS_PINNING_ENDPOINT=
HARDHAT_TESTNET_RPC_URL=
DEPLOYER_PRIVATE_KEY=
BLOCK_EXPLORER_API_KEY=
